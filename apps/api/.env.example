NODE_ENV=development
PORT=3500
MONGO_URI=mongodb://localhost:27017/linkgenserver
# Mongo connection pool, per process. Integers; min must not exceed max. A bad value fails boot.
# Sizing rule: the worker's MONGO_MAX_POOL_SIZE >= its total worker concurrency + 10.
MONGO_MAX_POOL_SIZE=10
MONGO_MIN_POOL_SIZE=2
REDIS_URL=redis://localhost:6379
# Worker only. How long a SIGTERM/SIGINT waits for running jobs to finish before
# the worker exits 1 (default 120000). Keep the host's drain window above it:
# on Railway, RAILWAY_DEPLOYMENT_DRAINING_SECONDS >= this / 1000 + 10.
WORKER_SHUTDOWN_TIMEOUT_MS=120000
# Worker only. Jobs each artifact-run queue runs at once: workflow (POST, POLL)
# and workflow-document (DOCUMENT). Integers >= 1, default 1; production starts
# at 10 and 2 (2 matches the Browserless Free plan's concurrent browsers).
# Keep MONGO_MAX_POOL_SIZE >= their sum + 10.
WORKFLOW_TEXT_CONCURRENCY=1
WORKFLOW_DOCUMENT_CONCURRENCY=1
# Worker only. The BullMQ job lock on both queues, in ms (default 30000, min 1000).
WORKFLOW_LOCK_DURATION_MS=30000
# API and worker. The most artifact runs one user may have in flight; a launch
# over it gets 429 run.too_many_in_flight. 0 or unset turns the cap off (no
# Redis calls). Planned: 3 once queueWaitMs shows users waiting behind a batch.
MAX_INFLIGHT_RUNS_PER_USER=0
# API and worker. How long a run holds its in-flight slot without a refresh, in
# seconds (default 1800, min 1). The worker refreshes it each job attempt and
# releases it when the run ends; this only frees a slot whose release was lost.
RUN_INFLIGHT_LEASE_SECONDS=1800
FRONTEND_URL=http://localhost:3000
FRONTEND_URL_DEV=http://localhost:3000

# Clerk (auth migration) — https://dashboard.clerk.com → API keys
CLERK_PUBLISHABLE_KEY=pk_test_change_me
CLERK_SECRET_KEY=sk_test_change_me
# PEM public key for networkless session-token verification (JWKS public key)
CLERK_JWT_KEY=change_me

PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=your_paddle_api_key_here
PADDLE_WEBHOOK_SECRET=your_paddle_webhook_secret_here
RESEND_API_KEY=JOJJJOJOJOJOOJ
MAIL_FROM=example@test.com
# Feedback issues include the reporter's email, so GITHUB_ISSUE_REPO must be a
# private repository. Use a fine-grained token scoped to that repo only, with
# Issues: read and write.
GITHUB_ISSUE_TOKEN=github_token_here
GITHUB_ISSUE_OWNER=repo_owner_here
GITHUB_ISSUE_REPO=repo_name_here

# Diagnostics: leave empty in normal operation. Set to a long random string
# (e.g. `openssl rand -hex 24`) to enable GET /api/v1/diagnostics/heap.
# When unset, the endpoint fail-closes with 401.
ADMIN_DIAG_TOKEN=


# LLM stack (src/llm strategies, used by the workflow engine)
OPENROUTER_API_KEY=sk-or-key
# OpenRouter retries, run by the app (the SDK's own are off). All optional;
# an invalid value fails boot. Each try ends at OPENROUTER_TIMEOUT_MS (research
# turns at 45 s; DOCUMENT drafts and Repairs at the run deadline when sooner).
# A 408, 429, 5xx, timeout or provider error after 200 OK is retried up to
# OPENROUTER_MAX_ATTEMPTS tries in all, sleeping Retry-After when sent, else a
# random 0..min(MAX_DELAY, BASE * 2^n) ms. A call stops retrying once its sleeps
# would pass OPENROUTER_RETRY_BUDGET_MS. Rollback: OPENROUTER_MAX_ATTEMPTS=1.
OPENROUTER_TIMEOUT_MS=240000
OPENROUTER_MAX_ATTEMPTS=3
OPENROUTER_RETRY_BASE_MS=1000
OPENROUTER_RETRY_MAX_DELAY_MS=15000
OPENROUTER_RETRY_BUDGET_MS=45000
# Per-role models, as OpenRouter slugs. Required: the agent refuses to boot
# without these rather than fall back to a hardcoded literal. GENERATION_MODEL is
# the stronger model for final content; RESEARCH_MODEL is the fast model that
# drives the research tool loop.
GENERATION_MODEL=openai/gpt-5.4
RESEARCH_MODEL=openai/gpt-5-mini
# Reasoning effort per call site. Optional; unset or empty sends no effort, so
# the model uses its own default (today's behaviour). Allowed values: max, xhigh,
# high, medium, low, minimal, none (lowercase); anything else fails boot.
# Supported efforts differ per model: gpt-6-luna-pro has no `minimal`, gpt-5-mini
# rejects `none`, and on gpt-5.4 any value but `none` turns reasoning on. An
# effort on a non-reasoning model makes OpenRouter require reasoning-capable
# providers (schema calls already send requireParameters), which can 404.
# RESEARCH: every research tool turn and the closing call.
# GENERATION: POST/POLL generation and its repair turn.
# DOCUMENT_DRAFT: a DOCUMENT draft and its envelope repair turn.
# DOCUMENT_REPAIR: a DOCUMENT Repair and its envelope repair turn.
RESEARCH_REASONING_EFFORT=
GENERATION_REASONING_EFFORT=
DOCUMENT_DRAFT_REASONING_EFFORT=
DOCUMENT_REPAIR_REASONING_EFFORT=
# Maximum completion budget for each role. Optional; both default to 8192.
# Explicit caps prevent OpenRouter from reserving a model's full output ceiling
# when it performs its preflight affordability check.
GENERATION_MAX_OUTPUT_TOKENS=8192
# Output cap for DOCUMENT drafts, which carry a whole HTML document.
DOCUMENT_GENERATION_MAX_OUTPUT_TOKENS=16384
RESEARCH_MAX_OUTPUT_TOKENS=8192
# How many tool-calling turns the research agent may take before it is forced to
# finalize (one extra tools-free completion). Optional; defaults to 5.
RESEARCH_MAX_STEPS=5
# Successful Tavily lookups across all turns in one research run. Values above
# the hard five-search safety ceiling are clamped; failed lookups consume none.
RESEARCH_MAX_SUCCESSFUL_SEARCHES=5

# Web search (Tavily) — used by the searchWeb tool the research agent calls.
TAVILY_API_KEY=tavily-api-key-672d672d672d672d672d672d672d672d672d672d672d672d672d672d672d672d
# Optional. Per-search timeout in seconds (default 10; the SDK's own default is 60).
TAVILY_TIMEOUT_S=10
# Optional. `advanced` (default) or `basic`; anything else falls back to `advanced`.
TAVILY_SEARCH_DEPTH=advanced

# Credits — all optional; the CreditMeterService falls back to these defaults.
# One credit represents $0.001 of raw provider cost before markup.
CREDITS_PER_USD=1000
CREDIT_MARKUP=2.0
# Safety-net rate used only when a provider omits its authoritative usage cost.
FALLBACK_CREDITS_PER_1K_TOKENS=10
# Provider-action pricing (in credits). Search is per successful lookup;
# Browserless is per measured unit with a successful-render minimum.
CREDIT_SURCHARGE_WEB_SEARCH=32
CREDIT_SURCHARGE_PDF_RENDER=4
CREDIT_MINIMUM_PDF_RENDER=8
# How long each process caches a tier document, in ms (FeatureGatingService).
# Tiers change only through the seed script, so a tier change takes up to this
# long to apply. 0 disables the cache. The subscription is never cached.
FEATURE_TIER_CACHE_TTL_MS=60000

# Object storage. R2_ENDPOINT selects an S3-compatible endpoint, here the local
# MinIO from `docker compose up -d` (console: http://localhost:9001). Production
# leaves R2_ENDPOINT unset and sets R2_ACCOUNT_ID to target Cloudflare R2.
R2_ENDPOINT=http://localhost:9000
# Production only
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin
R2_BUCKET_NAME=marquill-local

# Browserless, the worker's document render sessions (CDP over WebSocket).
# Defaults point at the local container from `docker compose up -d`. Production
# uses https://production-sfo.browserless.io and a real token.
BROWSERLESS_URL=http://localhost:3002
# Token appended to the session's WebSocket URL
BROWSERLESS_TOKEN=local-browserless-token
# Worker. Concurrent Browserless sessions across every worker: each render holds
# a Redis slot (browserless:slots) while its session runs, and waits for one when
# all are taken. Set it to the plan's limit; production on Browserless Free: 2.
# Unset or 0 turns the semaphore off. Redis errors let the render go ahead.
# Both processes read these at boot, so a bad value fails either.
BROWSERLESS_MAX_CONCURRENT_SESSIONS=
# Worker. The longest a render waits for a slot, in ms (default 120000); it never
# waits past 20 s before the run deadline. Past it the run fails as render.unavailable.
BROWSERLESS_SLOT_WAIT_MAX_MS=120000
