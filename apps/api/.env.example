NODE_ENV=development
PORT=3500
MONGO_URI=mongodb://localhost:27017/linkgenserver
REDIS_URL=redis://localhost:6379
JWT_SECRET=change_me
FRONTEND_URL=http://localhost:3000
FRONTEND_URL_DEV=http://localhost:3000

# Clerk (auth migration) — https://dashboard.clerk.com → API keys
CLERK_PUBLISHABLE_KEY=pk_test_change_me
CLERK_SECRET_KEY=sk_test_change_me
# PEM public key for networkless session-token verification (JWKS public key)
CLERK_JWT_KEY=change_me

PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=your_paddle_api_key_here
PADDLE_WEBHOOK_SECRET=your_paddle_webhook_secret_here
RESEND_API_KEY=JOJJJOJOJOJOOJ
MAIL_FROM=example@test.com
GITHUB_ISSUE_TOKEN=github_token_here
GITHUB_ISSUE_OWNER=repo_owner_here
GITHUB_ISSUE_REPO=repo_name_here

# Diagnostics: leave empty in normal operation. Set to a long random string
# (e.g. `openssl rand -hex 24`) to enable GET /api/v1/diagnostics/heap.
# When unset, the endpoint fail-closes with 401.
ADMIN_DIAG_TOKEN=


# LLM stack (src/llm strategies, used by the workflow engine)
OPENROUTER_API_KEY=sk-or-key
# Per-role models, as OpenRouter slugs. Required: the agent refuses to boot
# without these rather than fall back to a hardcoded literal. GENERATION_MODEL is
# the stronger model for final content; RESEARCH_MODEL is the fast model that
# drives the research tool loop.
GENERATION_MODEL=openai/gpt-5.4
RESEARCH_MODEL=openai/gpt-5-mini
# Maximum completion budget for each role. Optional; both default to 8192.
# Explicit caps prevent OpenRouter from reserving a model's full output ceiling
# when it performs its preflight affordability check.
GENERATION_MAX_OUTPUT_TOKENS=8192
RESEARCH_MAX_OUTPUT_TOKENS=8192
# How many tool-calling turns the research agent may take before it is forced to
# finalize (one extra tools-free completion). Optional; defaults to 5.
RESEARCH_MAX_STEPS=5
# Successful Tavily lookups across all turns in one research run. Values above
# the hard five-search safety ceiling are clamped; failed lookups consume none.
RESEARCH_MAX_SUCCESSFUL_SEARCHES=5

# Web search (Tavily) — used by the searchWeb tool the research agent calls.
TAVILY_API_KEY=tavily-api-key-672d672d672d672d672d672d672d672d672d672d672d672d672d672d672d672d

# Credits — all optional; the CreditMeterService falls back to these defaults.
# One credit represents $0.001 of raw provider cost before markup.
CREDITS_PER_USD=1000
CREDIT_MARKUP=2.0
# Safety-net rate used only when a provider omits its authoritative usage cost.
FALLBACK_CREDITS_PER_1K_TOKENS=10
# Provider-action pricing (in credits). Search is per successful lookup;
# Browserless is per measured unit with a successful-render minimum.
CREDIT_SURCHARGE_WEB_SEARCH=32
CREDIT_SURCHARGE_PDF_RENDER=4
CREDIT_MINIMUM_PDF_RENDER=8

# Cloudflare R2 (S3-compatible object storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Browserless.io PDF REST API
# Base URL of the browserless instance, e.g. https://production-sfo.browserless.io
BROWSERLESS_URL=https://production-sfo.browserless.io
# API token appended to the /pdf request
BROWSERLESS_TOKEN=
