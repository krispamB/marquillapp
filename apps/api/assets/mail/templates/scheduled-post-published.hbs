<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light" />
    <title>Your scheduled post is live</title>
  </head>
  <body style="margin: 0; padding: 0; background: #f6f6f4; font-family: Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif; color: #0a0a0a; -webkit-font-smoothing: antialiased;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background: #f6f6f4;">
      <tr>
        <td style="padding: 40px 16px;">
          <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width: 520px; margin: 0 auto;">
            <tr>
              <td style="padding: 0 4px 20px;">
                {{> logo}}
              </td>
            </tr>
            <tr>
              <td style="background: #ffffff; border: 1px solid #e7e7e3; border-radius: 14px; padding: 32px;">
                <p style="margin: 0 0 16px; font-size: 12px; line-height: 1; font-weight: 600; color: #1f9d55;">
                  <span style="display: inline-block; width: 6px; height: 6px; margin-right: 6px; border-radius: 3px; background: #1f9d55; vertical-align: middle;"></span><span style="vertical-align: middle;">Published</span>
                </p>
                <h1 style="margin: 0 0 12px; font-size: 22px; line-height: 1.3; font-weight: 600; letter-spacing: -0.01em; color: #0a0a0a;">
                  Your post is live, {{name}}
                </h1>
                <p style="margin: 0; font-size: 15px; line-height: 1.6; color: #3a3a38;">
                  The post you scheduled has been published to LinkedIn.
                </p>
                {{#if postUrl}}
                <table role="presentation" cellspacing="0" cellpadding="0" style="margin: 24px 0 0;">
                  <tr>
                    <td style="border-radius: 8px; background: #0a0a0a;">
                      <a href="{{postUrl}}" target="_blank" rel="noopener" style="display: inline-block; padding: 11px 18px; font-size: 14px; line-height: 1; font-weight: 600; color: #ffffff; text-decoration: none; border-radius: 8px;">View on LinkedIn</a>
                    </td>
                  </tr>
                </table>
                <p style="margin: 16px 0 0; font-size: 12px; line-height: 1.5; color: #76766f; word-break: break-all;">
                  Or open <a href="{{postUrl}}" target="_blank" rel="noopener" style="color: #3a3a38;">{{postUrl}}</a>
                </p>
                {{/if}}
              </td>
            </tr>
            <tr>
              <td style="padding: 20px 4px 0; font-size: 12px; line-height: 1.5; color: #76766f;">
                You're receiving this because you scheduled a post in Marquill.
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
