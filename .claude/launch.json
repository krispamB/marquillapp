{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["--cwd", "apps/web", "run", "dev"],
      "port": 3000
    },
    {
      "name": "landing",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["--cwd", "apps/landing", "run", "dev"],
      "port": 3001
    },
    {
      "name": "landing-static",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["-y", "serve", "apps/landing/out", "-l", "3008"],
      "port": 3008
    }
  ]
}
